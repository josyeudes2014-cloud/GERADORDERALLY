rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'admin@rallyfju.com' ||
        (userDoc().exists() && userDoc().data.role == 'admin')
      );
    }

    function isLeader() {
      return signedIn() && userDoc().exists() && userDoc().data.role == 'leader';
    }

    function leaderTribe() {
      return userDoc().data.tribeId;
    }

    function control() {
      return get(/databases/$(database)/documents/system/rally-control);
    }

    function systemUnlocked() {
      return !control().exists() || control().data.systemLocked != true;
    }

    function submissionsOpen() {
      return control().exists() && control().data.submissionOpen == true && systemUnlocked();
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }

    match /system/rally-control {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /rallies/current {
      allow read: if true;
      allow create, update: if isAdmin() && systemUnlocked();
      allow delete: if false;

      match /missions/{missionId} {
        allow read: if true;
        allow create, update, delete: if isAdmin() && systemUnlocked();
      }

      match /people/{personId} {
        allow read: if isAdmin();
        allow create, update, delete: if isAdmin() && systemUnlocked();
      }

      match /attendance/{attendanceId} {
        allow read: if isAdmin();
        allow create, update, delete: if isAdmin() && systemUnlocked();
      }

      match /weeklyScores/{scoreId} {
        allow read: if true;
        allow create, update: if (
          isAdmin() && systemUnlocked()
        ) || (
          isLeader() && submissionsOpen() &&
          request.resource.data.tribeId == leaderTribe() &&
          request.resource.data.week == get(/databases/$(database)/documents/rallies/current).data.currentWeek &&
          request.resource.data.points is number &&
          request.resource.data.points >= 0
        );
        allow delete: if isAdmin() && systemUnlocked();
      }

      match /announcements/{announcementId} {
        allow read: if true;
        allow create, update, delete: if isAdmin() && systemUnlocked();
      }
    }

    match /rallyArchives/{archiveId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
